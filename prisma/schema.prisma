generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id        String    @id @unique @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      UserRole  @default(USER)
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  surveys         Survey[]
  Questions       Question[]
  OptionAnswers   OptionAnswer[]
  Interviews      Interview[]
  AnswerQuestions AnswerQuestion[]
  sessions        Session[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  accountId  String    @map("account_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent") @db.VarChar(200)
  ipHash     String?   @map("ip_hash") @db.VarChar(64)

  account User @relation(fields: [accountId], references: [id], onDelete: Cascade)
  usedTokens SessionUsedToken[]

  @@index([accountId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model SessionUsedToken {
  tokenHash String   @id @map("token_hash")
  sessionId String   @map("session_id")
  usedAt    DateTime @default(now()) @map("used_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_used_tokens")
}

model RevokedTokenSubject {
  accountId     String   @id @map("account_id")
  revokedBefore DateTime @default(now()) @map("revoked_before")

  @@map("revoked_token_subjects")
}

model Survey {
  id        String    @id @unique @default(uuid())
  title     String
  location  String
  userId    String
  type      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  questions        Question[]
  interviews       Interview[]
  conditionalRules ConditionalRule[]

  @@map("surveys")
}

model Question {
  id        String    @id @unique @default(uuid())
  title     String
  number    Int
  surveyId  String
  userId    String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  conditionalRules          ConditionalRule[] @relation("QuestionToConditionalRule")
  dependsOnConditionalRules ConditionalRule[] @relation("dependsOnQuestion")

  user             User             @relation(fields: [userId], references: [id])
  survey           Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  option_answers   OptionAnswer[]
  answer_questions AnswerQuestion[]

  @@map("questions")
}

model OptionAnswer {
  id         String    @id @unique @default(uuid())
  option     String
  number     Int
  questionId String
  userId     String
  slug       String    @unique
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answer_questions          AnswerQuestion[]
  dependsOnConditionalRules ConditionalRule[] @relation("dependsOnOption")

  @@map("option_answers")
}

model Interview {
  id        String    @id @unique @default(uuid())
  surveyId  String
  userId    String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  survey           Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id])
  answer_questions AnswerQuestion[]

  @@map("interviews")
}

model AnswerQuestion {
  id             String    @id @unique @default(uuid())
  interviewId    String
  questionId     String
  optionAnswerId String
  userId         String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id])
  interview    Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id])
  optionAnswer OptionAnswer @relation(fields: [optionAnswerId], references: [id])

  @@map("answer_questions")
}

model ConditionalRule {
  id         String   @id @unique @default(uuid())
  questionId String
  question   Question @relation("QuestionToConditionalRule", fields: [questionId], references: [id])

  dependsOnQuestionNumber Int
  dependsOnQuestionId     String
  dependsOnQuestion       Question @relation("dependsOnQuestion", fields: [dependsOnQuestionId], references: [id])

  dependsOnOptionNumber Int
  dependsOnOptionId     String
  dependsOnOption       OptionAnswer @relation("dependsOnOption", fields: [dependsOnOptionId], references: [id])

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id])

  @@map("conditional_rules")
}
