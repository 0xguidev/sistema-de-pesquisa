{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.e2e-spec.ts",
    "test/**/*.ts",
    "vitest.config.mts",
    "vitest.config.e2e.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
