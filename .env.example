# Local development explicitly opts out of database TLS. Production must use
# DATABASE_TLS_MODE=require and sslmode=require, verify-ca, or verify-full.
DATABASE_URL="postgresql://user:password@localhost:5432/database?sslmode=disable"
DATABASE_TLS_MODE=disable

# Base64 of matching PEM RSA keys (minimum 2048 bits). Never commit real keys.
# Example generation commands are documented in docs/authentication-security.md.
JWT_PRIVATE_KEY="<base64-encoded-private-pem>"
JWT_PUBLIC_KEY="<base64-encoded-public-pem>"
PORT=3333

# Use * to allow any origin (not recommended in production).
# Multiple origins can be separated by commas.
CORS_ORIGIN="http://localhost:5173"

# bcrypt work factor (integer from 10 to 14). 10 is the conservative default
# for bcryptjs; benchmark production hardware before increasing it.
BCRYPT_COST=10

# Access tokens are short lived; refresh tokens continue to rotate.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Shared PostgreSQL storage is the secure default for multi-replica deployments.
# "memory" is intended only for local development and tests.
RATE_LIMIT_STORE=database
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_IDENTIFIER_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_IP_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT_IP_MAX=30
REFRESH_RATE_LIMIT_SESSION_MAX=10
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60

# Optional comma-separated SHA-256 digests (hex) added to the built-in denylist.
# Replace PasswordCompromiseChecker with an external provider for a larger corpus.
COMPROMISED_PASSWORD_SHA256=""

# Production: use Base64 for at least 32 cryptographically random bytes.
SESSION_IP_HASH_SECRET="<base64-encoded-32-byte-random-secret>"

# Enable only behind a trusted TLS-terminating proxy. When enabled, plain HTTP is
# rejected and HSTS is emitted on requests reported by that proxy as HTTPS.
TRUST_PROXY_HOPS=0
REQUIRE_HTTPS=false
